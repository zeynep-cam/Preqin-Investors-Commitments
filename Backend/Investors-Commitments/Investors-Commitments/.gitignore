# Ignore publish and deploy files
publish/
app.publish/

# Ignore coverage and test results
TestResults/
coverage/
*.coverlet/
*.trx
*.xml

# Ignore secrets (if applicable)
secrets.json

# Ignore Node.js dependencies (if using frontend)
node_modules/
